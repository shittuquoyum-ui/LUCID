{
  "name": "lucid",
  "displayName": "Lucid",
  "description": "After each commit, a plain-English lesson about what your change does.",
  "version": "0.1.0",
  "publisher": "lucid-dev",
  "repository": {
    "type": "git",
    "url": "https://github.com/shittuquoyum-ui/LUCID.git",
    "directory": "extension"
  },
  "homepage": "https://github.com/shittuquoyum-ui/LUCID#readme",
  "bugs": {
    "url": "https://github.com/shittuquoyum-ui/LUCID/issues"
  },
  "keywords": [
    "learn",
    "beginner",
    "explain",
    "git",
    "commit",
    "vibe coding"
  ],
  "private": true,
  "license": "MIT",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Education",
    "Other"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "extensionDependencies": [
    "vscode.git"
  ],
  "contributes": {
    "commands": [
      {
        "command": "lucid.setKeys",
        "title": "Lucid: Set API keys"
      },
      {
        "command": "lucid.signIn",
        "title": "Lucid: Sign in with GitHub"
      },
      {
        "command": "lucid.explainLastCommit",
        "title": "Lucid: Explain my last commit"
      },
      {
        "command": "lucid.showLastLesson",
        "title": "Lucid: Show last lesson"
      }
    ],
    "configuration": {
      "title": "Lucid",
      "properties": {
        "lucid.autoExplain": {
          "type": "boolean",
          "default": true,
          "description": "Explain each new commit automatically, in the background."
        },
        "lucid.useOwnKeys": {
          "type": "boolean",
          "default": false,
          "description": "Use your own Meta and Baseten keys (set with \"Lucid: Set API keys\") instead of Lucid's server. Your filtered diff then goes straight to Meta and Baseten."
        },
        "lucid.serverUrl": {
          "type": "string",
          "default": "https://shittuquoyum-ui--lucid-server.us-east.modal.run",
          "description": "The Lucid server that writes lessons when you are signed in with GitHub."
        }
      }
    }
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "typecheck": "tsc --noEmit -p .",
    "package": "npm run build && vsce package --no-dependencies --out lucid.vsix"
  },
  "devDependencies": {
    "@types/vscode": "~1.90.0",
    "@vscode/vsce": "^3.9.2",
    "esbuild": "^0.25.12",
    "typescript": "~5.8.2"
  }
}
