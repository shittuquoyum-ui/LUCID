# Copy this file to .env and fill in your own values. Never commit .env.

# Which model provider runs each step: fake | meta | baseten
LUCID_PICK_PROVIDER=fake
LUCID_WRITE_PROVIDER=fake

# Meta Model API (https://dev.meta.ai) — standard mode only for real user code
MODEL_API_KEY=

# Baseten (Muse Spark Open, open weights)
BASETEN_API_KEY=

# Optional: a GitHub token raises the API rate limit when fetching diffs
GITHUB_TOKEN=
