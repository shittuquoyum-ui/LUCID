--- /dev/null
+++ b/src/components/CheckoutButton.tsx
@@ -0,0 +1,13 @@
+'use client';
+
+import Stripe from 'stripe';
+
+const stripe = new Stripe('sk_live_fakekeyfortests');
+
+export function CheckoutButton({ priceId }: { priceId: string }) {
+  const buy = async () => {
+    const session = await stripe.checkout.sessions.create({ mode: 'payment', line_items: [{ price: priceId, quantity: 1 }], success_url: window.location.href });
+    window.location.href = session.url!;
+  };
+  return <button onClick={buy}>Buy</button>;
+}
